#!/bin/sh
# This template lets Ejudge find and describe the Schemio interpreter.
# Edit it when Schemio's version output or installed binary path changes.
# Copy it into Ejudge's compile/scripts/in directory when adding Schemio.

LANG_CONFIG_DIR="@lang_config_dir@"

common_config() {
  echo 'long_name="Schemio logic scheme interpreter"'
  echo 'src_sfx=".sch"'
  echo 'arch="linux-shared"'
}

failure() {
  rm -f conftest.sch
  echo 'version='
  echo 'arg="'"${arg}"'"'
  common_config
  echo 'SCHEMIOPATH=/bin/false'
  [ "${verbose}" = 1 ] && echo "no" >&2
  exit 1
}

unset LANG
unset LC_ALL
unset LC_MESSAGES
unset LANGUAGE

if [ x"$1" = x-v ]
then
  verbose=1
  shift
fi

if [ x"$1" = x-r ]
then
  arg="$2"
  [ x"$2" != x ] && schemio="$2"
  [ "${schemio}" = "" ] && schemio="/opt/ejudge/schemio"

  [ "${verbose}" = 1 ] && printf "checking whether Schemio is available..." >&2
  "${schemio}" --version >/dev/null 2>&1 || failure
  version=$("${schemio}" --version 2>&1 | awk '$1 == "schemio" { print $2; exit }') || failure
  [ "${version}" != "" ] || failure
  SCHEMIOPATH=$(command -v "${schemio}") || failure
  [ -x "${SCHEMIOPATH}" ] || failure

  cat > conftest.sch <<'EOF'
scheme (a) main (out):
 (a) not (out)
end
EOF
  output=$(printf '0\n' | "${SCHEMIOPATH}" conftest.sch) || failure
  [ "${output}" = "1" ] || failure

  rm -f conftest.sch
  echo 'version="'"${version}"'"'
  echo 'arg="'"${arg}"'"'
  common_config
  echo 'SCHEMIOPATH="'"${SCHEMIOPATH}"'"'
  [ "${verbose}" = 1 ] && echo "yes, ${SCHEMIOPATH}, ${version}" >&2
  exit 0
fi

if [ x"$1" = x-l ]
then
  echo "Schemio logic scheme interpreter [https://github.com/leaders-tech/scheme]"
  exit 0
fi

[ "${EJUDGE_LANG_CONFIG}" = "" ] && EJUDGE_LANG_CONFIG="${LANG_CONFIG_DIR}/schemio.cfg"

if [ -f "${EJUDGE_LANG_CONFIG}" ]
then
  . "${EJUDGE_LANG_CONFIG}"
else
  SCHEMIOPATH="/opt/ejudge/schemio"
fi

if [ x"${SCHEMIOPATH}" = x -o x"${SCHEMIOPATH}" = x/bin/false ]
then
  echo "This language is not supported." >&2
  exit 1
fi

if [ x"$1" = x-p ]
then
  echo "${SCHEMIOPATH}"
  exit 0
fi

"${SCHEMIOPATH}" --version >/dev/null 2>&1 || exit 1
[ x"$1" = x-f ] && printf "Schemio "
"${SCHEMIOPATH}" --version 2>&1 | awk '$1 == "schemio" { print $2; exit }'
